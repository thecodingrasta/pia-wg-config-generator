PIA_USERNAME=p1234567
PIA_PASSWORD=yourPassword

# Use a region that supports port forwarding when --port-forwarding is enabled.
# Check with: pia-wg-config regions --username YOU --password SECRET --pf-only
PIA_REGION=ca_toronto

# on = dual stack, off = IPv4 only, kill = dual stack with an IPv6 block rule
IPV6_MODE=kill

TZ=Europe/London

# Windows only, and only if the inbox curl is rejected by PIA's token endpoint.
# Leave this commented out everywhere else: a CURL_PATH that does not exist is a
# fatal error, so a Windows path copied into a Docker env file stops the tool.
# CURL_PATH=C:\openssl_cURL\curl.exe
