# Copy to .env next to docker-compose.yml:  cp .env.example .env
# .env holds credentials. It is git-ignored; never commit it.

PIA_USERNAME=p1234567
PIA_PASSWORD=yourPassword

# Must be a port-forwarding-capable region (the stack enables --port-forwarding).
# List them with:  pia-wg-config regions --pf-only
PIA_REGION=ca_toronto

# on = dual stack, off = IPv4 only, kill = dual stack plus an IPv6 block rule
IPV6_MODE=kill

TZ=Europe/London

# Image used for pia-wg-refresh and pia-wg-pf. Defaults to the published
# release. To run a local build instead:  docker build -t pia-wg-config-generator:local .
# PIA_WG_IMAGE=pia-wg-config-generator:local

# Optional failure/recovery alerts. Discord webhook or ntfy topic URL. Treat it as a secret.
# PIA_WG_ALERT_WEBHOOK=https://ntfy.sh/your-long-random-topic
